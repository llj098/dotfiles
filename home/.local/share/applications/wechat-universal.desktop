[Desktop Entry]
Comment=WeChat Universal
TryExec=/usr/lib/wechat-universal/start.sh
Exec=/usr/bin/env QT_SCALE_FACTOR=1.6 XCURSOR_SIZE=12 XMODIFIERS=@im=fcitx QT_IM_MODULE=fcitx GTK_IM_MODULE=fcitx WECHAT_IME_WORKAROUND=fcitx /usr/lib/wechat-universal/start.sh %u
Icon=wechat-universal
Name=WeChat (Universal)
Name[zh_CN]=微信 Universal
Categories=Network;InstantMessaging;Chat;
Terminal=false
Type=Application
Keywords=wechat;weixin;we;w;
StartupWMClass=wechat
Actions=quit;

[Desktop Action quit]
Name=Quit WeChat
Name[zh_CN]=退出
Exec=/usr/lib/wechat-universal/stop.sh
Icon=application-exit
