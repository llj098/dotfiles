[Hotkey/AltTriggerKeys]
# Do NOT delete this section. fcitx5's built-in default for AltTriggerKeys is
# Shift_L (临时切换输入法 / temporary IM toggle); it swallows the LEFT Shift
# key, so the key never reaches Rime and 万象's ascii_composer switch_key
# (Shift_L/Shift_R: commit_code) can never toggle 中/英. An empty value is NOT
# enough (falls back to the default) — bind it to a key that does not exist.
# See fcitx5-rime issues #13 / #15.
0=F13

[Hotkey/TriggerKeys]
0=Control+Shift+space

[Behavior]
ShareInputState=No
ActiveByDefault=True
